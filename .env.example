# ════════════════════════════════════════════════════════════════════════════════
# ↑↑↑ IMPORTANT — start here ↑↑↑
#
# To unlock the FULL investigation, get a free Etherscan V2 API key:
#   1. Visit https://etherscan.io/apis (signup, ~30 seconds, no credit card)
#   2. Copy your key
#   3. Paste it on the ETHERSCAN_API_KEY line below (replacing YOUR_KEY_HERE)
#   4. Restart the dev server
#
# ONE key covers ALL 6 EVM chains in this project (Ethereum, Base, Arbitrum,
# Optimism, Polygon, BNB). Without it, the app still runs and 5 of the
# 9 investigation checks return INSUFFICIENT EVIDENCE instead of real data.
# ════════════════════════════════════════════════════════════════════════════════

ETHERSCAN_API_KEY=YOUR_KEY_HERE

# ── Optional: LLM narrative (improves the Plain-English verdict) ──
# With either of these set, findings get translated by an LLM that is hard-
# restricted from inventing numbers. Without them, you get a structured
# deterministic summary — honest, but less smooth prose.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional: Bitquery free-tier token (richer cross-chain holder data) ──
BITQUERY_TOKEN=

# ── Optional: Public RPC overrides ──
# Defaults below are publicnode.com endpoints (free, no signup, no key).
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
